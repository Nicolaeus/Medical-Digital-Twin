{
  "Application": {
    "Name": "Medical Digital Twin",
    "Version": "0.1.0"
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../database/mdt.db"
  },

  "Storage": {
    "DicomRoot": "../../data/dicom",
    "ImagingRoot": "../../data/imaging",
    "ImportRoot": "../../data/imports"
  },

  "Segmentation": {
    "Engine": "TotalSegmentator",
    "PythonExecutable": "python",
    "ScriptPath": "../../python/imaging/segmentation"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}